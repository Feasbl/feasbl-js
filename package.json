{
  "name": "@feasbl/sdk",
  "version": "1.0.0",
  "type": "module",
  "description": "JavaScript builders and client utilities for Feasbl optimization models.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Feasbl/feasbl-js.git"
  },
  "homepage": "https://github.com/Feasbl/feasbl-js#readme",
  "bugs": {
    "url": "https://github.com/Feasbl/feasbl-js/issues"
  },
  "files": [
    "src/",
    "examples/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "coverage": "npm run typecheck && c8 --reporter=text --reporter=lcov --reporter=json-summary --reporter=html node --test",
    "smoketest": "node scripts/smoketest.js",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "test": "npm run typecheck && node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "typescript": "^5.9.3"
  }
}
