{
  "name": "@feasbl/sdk",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "JavaScript builders and client utilities for Feasbl optimization models.",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "coverage": "npm run typecheck && c8 --reporter=text --reporter=lcov --reporter=json-summary --reporter=html node --test",
    "smoketest": "node scripts/smoketest.js",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "test": "npm run typecheck && node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "typescript": "^5.9.3"
  }
}
